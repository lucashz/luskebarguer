[Unit]
Description=TáPronto Reel Rendering Worker
After=network-online.target postgresql.service cardapio.service
Wants=network-online.target

[Service]
Type=simple
User=lucas
Group=lucas
WorkingDirectory=/var/www
EnvironmentFile=/var/www/.env
Environment=FONTCONFIG_PATH=/etc/fonts
Environment=XDG_CACHE_HOME=/tmp
ExecStart=/usr/bin/node /var/www/scripts/reel-render-worker.mjs
Restart=always
RestartSec=8
Nice=10
CPUQuota=80%
MemoryMax=768M
TasksMax=128
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/uploads
CapabilityBoundingSet=
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
