FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium dumb-init fonts-liberation \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --chown=node:node . .
RUN install -d -o node -g node /app/artifacts/outreach/automated
USER node

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "scripts/outreach-worker.mjs", "worker"]
